// Maintenance Portal — Stage 0 lean MVP data model
// Two-sided marketplace: customers submit booking requests, admins dispatch
// them to partner contractors. See ../README.md for context.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The service catalog: Category -> Subcategory -> Accessory, each accessory
// carrying a Low/Medium/High price tier with its typical brand. Seeded from
// prisma/data/catalog.json (sourced from the client's fixtures spreadsheet)
// — see prisma/seed.ts.
model ServiceCategory {
  id            String               @id @default(cuid())
  name          String               @unique // "Electrical", "Sanitary Fixtures", ...
  icon          String // emoji shown in the category picker
  gradient      String // Tailwind gradient classes for the category card
  sortOrder     Int
  subcategories ServiceSubcategory[]
}

model ServiceSubcategory {
  id         String             @id @default(cuid())
  name       String // "Lighting", "Toilet / WC", ...
  sortOrder  Int
  categoryId String
  category   ServiceCategory    @relation(fields: [categoryId], references: [id])
  accessories ServiceAccessory[]

  @@unique([categoryId, name])
}

model ServiceAccessory {
  id            String             @id @default(cuid())
  name          String // "LED Spot / Downlight (recessed, ~12-24W)"
  sortOrder     Int
  subcategoryId String
  subcategory   ServiceSubcategory @relation(fields: [subcategoryId], references: [id])
  lowBrand      String
  lowPrice      Int // SAR — part/fixture cost only
  mediumBrand   String
  mediumPrice   Int // SAR
  highBrand     String
  highPrice     Int // SAR
  // Technician labor/callout fee for this specific job, same across quality
  // tiers (installing a cheap or expensive tap takes the same effort).
  // Market-researched: SR 100 floor for quick swaps, scaling up to SR 350-500
  // for heavy jobs like split AC installs. See prisma/data/catalog.json.
  laborFee      Int // SAR

  @@unique([subcategoryId, name])
}

model Contractor {
  id            String @id @default(cuid())
  name          String // company/legal name
  contactPerson String? // who we deal with day-to-day at this company
  category      String // matches ServiceCategory.name, e.g. "Electrical"
  city          String
  phone         String
  // Onboarding funnel per the Partnership Framework doc: screening call ->
  // document/license checks -> active partner (or suspended/rejected).
  // `active` is a separate manual on/off switch admin can flip even for an
  // otherwise-Active partner (e.g. temporarily pause a partner who's overbooked).
  onboardingStatus String  @default("APPLIED") // APPLIED | UNDER_REVIEW | ACTIVE | SUSPENDED | REJECTED
  active           Boolean @default(true)
  tier             String  @default("Bronze") // Bronze | Silver | Gold — see Partnership Framework §Tiering
  // License/insurance checks required before going Active — see Feasibility
  // Study & Risk Analysis docs (Balady municipal license is mandatory for
  // every partner; Civil Defense/SCA only applies to some trades).
  baladyLicenseNumber       String?
  baladyLicenseExpiry       String? // ISO date, e.g. "2027-03-01"
  civilDefenseLicenseNumber String?
  licenseVerified           Boolean @default(false)
  insuranceVerified         Boolean @default(false)
  // Commercial terms — see Partnership Framework §"Commission & payment
  // terms" and Financial Plan §pricing. 18% is the recommended starting
  // commission (adjustable 15-25% per contractor, e.g. lower for a partner
  // doing mostly large jobs); the agreement itself is drafted/signed outside
  // this tool (see business-plan/07-Partnership-Framework.md), we just track
  // whether it's been signed and when.
  commissionRate      Int     @default(18) // percent, 0-100
  agreementSigned     Boolean @default(false)
  agreementSignedDate String? // ISO date, e.g. "2026-08-01"
  adminNotes          String? // internal notes, not shown to the contractor
  createdAt                 DateTime  @default(now())
  bookings                  Booking[]
}

model Feedback {
  id        String   @id @default(cuid())
  page      String // pathname the comment was left on, e.g. "/admin"
  comment   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Booking {
  id           String @id @default(cuid())
  // Shared by every Booking created from the same form submission, so a
  // customer requesting several different jobs in one visit (e.g. 2 taps +
  // 1 AC) gets one combined request page and one shared visit slot, while
  // each job is still dispatched, tracked, and priced independently (they
  // may need different contractors and finish at different times).
  requestId    String
  customerName String
  phone        String
  city         String
  // Snapshot of the catalog selection at booking time (not a live FK) so
  // historical bookings stay accurate even if catalog prices change later.
  category    String // e.g. "Electrical"
  subcategory String // e.g. "Lighting"
  accessory   String // e.g. "LED Spot / Downlight (recessed, ~12-24W)"
  qualityTier String // "Low" | "Medium" | "High"
  quantity      Int    @default(1)
  selectedBrand String
  selectedPrice Int // SAR — part/fixture cost, per unit
  laborFee      Int // SAR — technician labor/callout fee, per unit
  totalPrice    Int // SAR — quantity * (selectedPrice + laborFee), stored so
  // historical invoices stay accurate even if catalog prices change later
  description String
  // Location: captured either by dropping a pin (lat/lng) or pasting a
  // Google Maps link — at least one of the two is required (enforced in
  // the server action, not the schema).
  locationLat     Float?
  locationLng     Float?
  locationMapLink String?
  // Fine-grained detail a map pin can't capture.
  addressDetails    String
  preferredDate     String // ISO date, e.g. "2026-08-10"
  preferredTimeSlot String // e.g. "08:00 AM - 08:30 AM"
  status            String      @default("PENDING") // PENDING | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED
  contractorId      String?
  contractor        Contractor? @relation(fields: [contractorId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([requestId])
}
