// Maintenance Portal — Stage 0 lean MVP data model
// Two-sided marketplace: customers submit booking requests, admins dispatch
// them to partner contractors. See ../README.md for context.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Contractor {
  id        String    @id @default(cuid())
  name      String
  trade     String // Electrical | Plumbing | HVAC | Civil Finishes
  city      String
  phone     String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Feedback {
  id        String   @id @default(cuid())
  page      String // pathname the comment was left on, e.g. "/admin"
  comment   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Booking {
  id            String    @id @default(cuid())
  customerName  String
  phone         String
  city          String
  trade         String // Electrical | Plumbing | HVAC | Civil Finishes
  description   String
  address       String
  preferredTime String
  status        String    @default("PENDING") // PENDING | ASSIGNED | IN_PROGRESS | COMPLETED | CANCELLED
  contractorId  String?
  contractor    Contractor? @relation(fields: [contractorId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
